# P21 API Configuration
P21_BASE_URL=https://your-p21-server.com
P21_USERNAME=your_username
P21_PASSWORD=your_password
P21_VERIFY_SSL=false

# Consumer Key Authentication (optional - see docs/00-Authentication.md)
P21_CONSUMER_KEY=your-consumer-key-guid
P21_CONSUMER_USERNAME=your_p21_username

# Comma-separated company identifiers scripts/fetch_definitions.py refuses to
# write into a committed definition (secondary scrub gate on top of the
# ufc_*/ValidValues sanitizer). Set before publishing fetched output.
P21_SCRUB_TERMS=YourCompany,yourcompany.com
