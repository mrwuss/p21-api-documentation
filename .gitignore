# Environment
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/

# IDE
.vscode/
.idea/

# Test results (regenerated on each run)
examples/python/transaction/session_pool_results.json

# Playwright MCP logs
.playwright-mcp/

# Scraped data
scraped/

# Local reference clones (third-party repos, never commit)
reference/

# Agent scratch: subagent worktrees and task transcripts
.claude/worktrees/
.claude/tasks/

# Misc local files (repo root only)
/*.png

# Local Prettier config (kept out of the repo so it can't silently reformat
# docs/*.md on someone's format-on-save -- Prettier can't match this repo's
# markdown table/emphasis style, see .prettierignore)
.prettierrc.json
.prettierignore
